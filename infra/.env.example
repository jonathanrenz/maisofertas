# Copie para .env e preencha antes de rodar `docker compose up -d`.
# Nunca commite o .env de verdade (já está no .gitignore).

# --- Banco de dados (Postgres compartilhado: app usa DB_NAME, Evolution usa "evolution") ---
DB_NAME=maisofertas
DB_USER=maisofertas
DB_PASSWORD=troque-por-uma-senha-forte

# --- Dedup / agendamento ---
DEAL_DEDUP_WINDOW_DAYS=7
PUBLISH_INTERVAL_MS=300000

# --- IA (legenda das ofertas) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# --- Telegram ---
# Token do @BotFather e o chat_id do canal (ex: -1001234567890 ou @meucanal)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp (Evolution API) ---
EVOLUTION_INSTANCE=maisofertas
EVOLUTION_API_KEY=troque-por-uma-chave-forte
# JID do grupo de ofertas (formato 1234567890@g.us) - pegue depois de conectar a instância
EVOLUTION_GROUP_JID=

# --- Amazon ---
# Tracking ID do Associados (ex: maisofertas-20). Aplicado automaticamente em toda
# URL de deal da Amazon que ainda não tiver um "tag=" explícito.
AMAZON_ASSOCIATE_TAG=

# --- Canopy API (busca automática de ofertas Amazon - Fase 1) ---
# Key do dashboard em canopyapi.co (REST). Plano free = 100 requests/mês.
CANOPY_API_KEY=
# BR = amazon.com.br. Outros: US, UK, CA, DE, FR, IT, ES, AU, IN, MX, JP, PL
CANOPY_DOMAIN=BR
# Só vira deal se o desconto for >= X%
CANOPY_MIN_DISCOUNT_PERCENT=20
# Desligado até a key estar configurada
CANOPY_SYNC_ENABLED=false
# 8h (3 rodadas/dia) x 1 página/rodada x 30 dias = ~90 requests/mês, dentro do free tier
CANOPY_SYNC_INTERVAL_MS=28800000
CANOPY_SYNC_PAGES_PER_RUN=1

# --- Shopee Affiliate Open API (busca automática de ofertas Shopee) ---
# App ID e Secret do painel em affiliate.shopee.com.br > Open API. NUNCA commite o secret real.
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Palavra-chave da busca de produtos (vazio = catálogo geral, sem filtro de termo)
SHOPEE_KEYWORD=
# Ordenação da Shopee: 1=relevância, 2=mais vendidos, 3=maior preço, 4=menor preço, 5=comissão
SHOPEE_SORT_TYPE=5
# Só vira deal se o desconto for >= X%
SHOPEE_MIN_DISCOUNT_PERCENT=20
# Desligado até validar o mapeamento de campos com uma sincronização real (ver aviso em
# ShopeeClient.java) - não é só faltar a key, o schema da API não foi confirmado com uma chamada
# de verdade ainda.
SHOPEE_SYNC_ENABLED=false
SHOPEE_SYNC_INTERVAL_MS=28800000
SHOPEE_SYNC_PAGES_PER_RUN=1
SHOPEE_SYNC_LIMIT_PER_PAGE=20
